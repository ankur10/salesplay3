      "css": ".ds-composer{font-family:var(--sans,'Source Sans 3',sans-serif);border:1px solid #92adb8;border-radius:5px;background:white;box-shadow:0 5px 16px #092b3d08;padding:14px 16px;max-width:780px}.ds-composer:focus-within{border-color:#b1abdf}.ds-context{display:inline-flex;background:#edf2f4;color:#375a6c;font-size:11px;border-radius:2px;padding:4px 6px}.ds-message{font-family:var(--sans,'Source Sans 3',sans-serif);display:block;resize:none;border:0;outline:none;width:100%;height:52px;font-size:16px;line-height:1.5;padding:8px 0;color:var(--ink,#092332)}.ds-message::placeholder{color:var(--muted,#536875)}.ds-send{background:#106a68;color:white;border:0;border-radius:3px;width:31px;height:31px;margin-left:auto;display:grid;place-items:center;cursor:pointer}.ds-send:hover{background:#084d4c}.ds-send:focus-visible{outline:2px solid #2476cc;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-composer,.ds-context,.ds-message,.ds-send{transition:none;animation:none}}"
    }
