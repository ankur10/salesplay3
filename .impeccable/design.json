      "html": "<button class=\"ds-primary\">Accept opportunity</button>",
      "css": ".ds-primary{font-family:var(--sans,'Source Sans 3',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:39px;padding:9px 13px;border:1px solid #9daeb9;border-radius:3px;background:#fff;color:var(--ink,#092332);font-size:13px;font-weight:600;cursor:pointer;transition:background .15s,border-color .15s;background:#145cb4;border-color:#145cb4;color:white}.ds-primary:hover{background:#0b4690}.ds-primary:focus-visible{outline:2px solid #2476cc;outline-offset:3px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;animation:none}}"
