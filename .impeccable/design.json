      "css": ".ds-row{font-family:var(--sans,'Source Sans 3',sans-serif);padding:22px 20px;border:1px solid #d2dfe5;border-radius:3px;background:white}.ds-row:hover{background:#f7fbfd}.ds-title{color:#103346;font-size:17px;font-weight:620;line-height:1.35;letter-spacing:-.01em;text-decoration:none}.ds-title:hover{color:#145cb4}.ds-title:focus-visible{outline:2px solid #2476cc;outline-offset:3px}.ds-preview{font-size:13px;line-height:1.55;color:var(--muted,#536875);margin:9px 0 0}@media(prefers-reduced-motion:reduce){.ds-row,.ds-title,.ds-preview{transition:none;animation:none}}"
