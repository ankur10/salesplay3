  "narrative": {
    "northStar": "The editorial account workspace",
    "overview": "SalesPlay uses an editorial research workspace: a deep navy command bar, white account rail, cool reading surfaces, cobalt actions, and teal relationship cues. Source Serif 4 gives research and page headings a measured reading hierarchy; Source Sans 3 keeps dense controls and named people clear. This replacement direction draws on the giq2 Advisory reference without claiming an exact reproduction.\n\nThis records the implemented prototype and its established visual world. The inherited base is layered through src/styles.css, src/premium.css, src/themes.css, src/workspace.css, and finally src/accounts.css. Theme roles govern colour; workspace refinements govern shared readability; account styles extend portfolio layout and navigation. The frontmatter and original component samples retain the established base tokens; later refinements below describe the active overrides.",
    "keyCharacteristics": [
      "Serif reading hierarchy with compact sans-serif controls.",
      "A global command bar for account search and Ask SalesPlay.",
      "First-class named contacts beside the opportunity queue.",
      "Fine rules, precise corners, and mostly flat surfaces."
    ],
    "rules": [
      {
        "name": "The Evidence Label Rule",
        "body": "Pair evidence color with its written strength; color does not establish product fit or a qualified outcome.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep reading surfaces visually flat; stronger elevation identifies temporary foreground controls.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve complete opportunity titles, evidence labels, and source references.",
      "Do keep search, Ask SalesPlay, and entity context visible in their established locations.",
      "Do use local font assets, clear focus treatments, and reduced-motion behavior.",
      "Do disclose captured scope and scripted AI."
    ],
    "donts": [
      "Don't restore the superseded lavender visual direction.",
      "Don't substitute anonymous metrics for named contacts.",
      "Don't imply captured records or scripted responses are live integrations.",
      "Don't apply heavy shadows or large rounding to reading surfaces."
    ]
  }
}
