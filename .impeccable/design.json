      "css": ".ds-people{font-family:var(--sans,'Source Sans 3',sans-serif);max-width:292px;background:white;border-top:3px solid #1c6872;padding:22px 20px 18px;box-shadow:0 3px 14px #113c4e06}.ds-people h2{font-family:var(--serif,\"Source Serif 4\",Georgia,serif);font-size:22px;font-weight:450;color:#123f4b;margin:0}.ds-people p{font-size:13px;line-height:1.6;color:var(--muted,#536875);margin:8px 0 20px}.ds-people a{font-size:13px;color:var(--accent,#1859b9);text-decoration:none}.ds-people a:hover{text-decoration:underline}.ds-people a:focus-visible{outline:2px solid #2476cc;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-people{transition:none;animation:none}}"
