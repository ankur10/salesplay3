{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/deck",
      "destination": "/deck/"
    },
    {
      "source": "/deck/video",
      "destination": "/deck/video/"
    }
  ]
}
